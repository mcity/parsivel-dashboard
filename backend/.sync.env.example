# Settings for scripts/sync_to_aws.py. Copy to backend/.sync.env (gitignored).

# Source SQL Server
PARSIVEL_SQL_SERVER=<sql-server-host>
PARSIVEL_SQL_DATABASE=<database-name>
# Read-only domain account. Leave PARSIVEL_SQL_USER empty to use the Windows
# identity of the process (e.g. a task running as the service account).
PARSIVEL_SQL_USER=<DOMAIN>\<read-only-account>
PARSIVEL_SQL_PASSWORD=

# AWS instance
PARSIVEL_SSH_HOST=<ec2-public-ip-or-dns>
PARSIVEL_SSH_USER=ec2-user
PARSIVEL_SSH_KEY=C:\path\to\UMTRI-precipitation-app.pem
PARSIVEL_CONTAINER=parsivel-demo
# Host directory bind-mounted at /incoming in the container (relative to the
# SSH user's home).
PARSIVEL_REMOTE_INCOMING=incoming

# Optional: comma-separated subset of the five tables.
# PARSIVEL_TABLES=parsivel_OTT,parsivel_avg_ps,parsivel_avg_ved,parsivel_ved_histogram,parsivel_ved_histogram_value
